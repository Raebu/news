# Names/placeholders only. Never commit live secret values.
NODE_ENV=development
SERVICE_NAME=publishing-api
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SERVICE_SHARED_SECRET=replace-with-at-least-32-characters
PUBLIC_BASE_URL=https://example.invalid
AI_PUBLISHING_ENABLED=false

# Cloudinary media authority.
CLOUDINARY_CLOUD_NAME=u7dpgaxh
CLOUDINARY_ASSET_FOLDER=Cloudinary/The_Raeburn_Holding_Group_Ltd/news
